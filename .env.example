# Multimodal Document Intelligence Backend Environment Configuration

# Server settings (0.0.0.0 allows container and LAN connections)
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Static Frontend Hosting (Set to True to serve frontend directly on port 8000 at '/')
SERVE_FRONTEND=True

# Allowed CORS origins (comma-separated origins; ALLOWED_ORIGINS is also supported)
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://localhost:3000
# Optional CORS regex pattern (leave blank unless specific regex restriction is needed)
CORS_ORIGIN_REGEX=

# Document Processing Settings
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
MAX_PAGES=15                    # Maximum PDF pages to process

# OCR Settings
# Optional external Tesseract binary path if installed (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
# Path to directory containing eng.traineddata (defaults to backend/app/tessdata)
TESSDATA_DIR=backend/app/tessdata
OCR_DPI=150

# Extraction & Validation Settings
CONFIDENCE_THRESHOLD=0.60       # Below this threshold fields are marked 'low_confidence'
ROUNDING_TOLERANCE=0.05         # Dollar/currency arithmetic tolerance

# Report Directory
REPORTS_DIR=reports
